# Comma-separated list of account tokens to run simultaneously.
DISCORD_TOKENS=token1,token2

# Comma-separated guild IDs to watch across all accounts.
# Leave empty to watch every guild each account has access to.
WATCHED_GUILDS=

# Default channel ID to log edits and deletes into. Whichever account
# has access to this channel will post there.
LOG_CHANNEL_ID=

# Optional: per-guild log channel overrides, comma-separated: guild_id:channel_id
# Events from a listed guild go to that guild's channel; every other guild falls
# back to LOG_CHANNEL_ID. Use this to send different servers' logs to different
# channels — including servers where only some of your poster tokens are members.
# Example: LOG_CHANNELS=guild_id:channel_id,guild_id:channel_id
LOG_CHANNELS=

# Optional: legitimate Discord bot token(s) for posting to the log channels
# (recommended). Comma-separated for multiple bots. Each bot only needs
# Send Messages + Attach Files in the channels it should post to. For any given
# log channel, the first bot that can see it posts there; if no bot can, a user
# poster or main account that can see it is used instead.
# LOG_POSTER_BOT_TOKEN (singular) is still accepted and merged in.
# Example: LOG_POSTER_BOT_TOKENS=bot_token_a,bot_token_b
LOG_POSTER_BOT_TOKENS=

# Optional: secondary user account token(s) for posting to the log channels,
# comma-separated. These accounts do not need to be in any WATCHED_GUILDS.
# Use multiple when no single account is in every server you log — each channel
# is posted to by whichever poster (or main account) can actually see it.
# LOG_POSTER_TOKEN (singular) is still accepted and merged in.
# Example: LOG_POSTER_TOKENS=user_token_a,user_token_b
LOG_POSTER_TOKENS=

# Channel-to-webhook mirror pairs, comma-separated: channel_id:webhook_url
# Repeat a channel_id with different URLs to fan out to multiple webhooks.
# Messages are queued in SQLite and posted with the original author's avatar and username.
MIRROR_CHANNELS=

# Whole-server mirror pairs, comma-separated: source_guild_id:dest_guild_id
# The bot auto-detects which token is in each guild and creates matching channels,
# categories, forums, and webhooks in the destination server on startup.
# The destination server is wiped and rebuilt from scratch on every startup.
# Channels and forums created in the source guild after startup are mirrored automatically too.
# Channels that are visible but unreadable (Forbidden) are placed in a '🔒 Unreadable'
# category and moved to their proper location automatically once permissions open up.
MIRROR_SERVERS=
